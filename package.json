{
  "name": "content-studio",
  "version": "1.2.13",
  "description": "Content Studio - AI article generation, images, recipes, and WordPress publishing",
  "main": "electron/main.js",
  "author": "Mahdi Bouizmoune",
  "license": "UNLICENSED",
  "private": true,
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "concurrently \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "build": "vite build",
    "preview": "vite preview",
    "electron:dev": "npm run dev",
    "electron:start": "electron .",
    "test": "node --test tests/reliability.test.js",
    "dist": "vite build && electron-builder --config.win.signAndEditExecutable=false",
    "dist:win": "vite build && electron-builder --win --config.win.signAndEditExecutable=false",
    "dist:mac": "vite build && electron-builder --mac"
  },
  "dependencies": {
    "axios": "^1.18.0",
    "csv-parse": "^6.2.1",
    "electron-log": "^5.2.0",
    "electron-store": "^8.2.0",
    "fast-xml-parser": "^5.10.0",
    "jszip": "^3.10.1",
    "replicate": "^1.0.1",
    "sharp": "^0.33.5"
  },
  "overrides": {
    "fast-uri": "^3.1.3"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^40.0.0",
    "electron-builder": "^26.8.1",
    "javascript-obfuscator": "^5.4.3",
    "lucide-react": "^0.460.0",
    "postcss": "^8.4.49",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.15",
    "vite": "^7.0.0",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.contentstudio.desktop",
    "productName": "Content Studio",
    "files": [
      "electron/*.js",
      "dist/**/*",
      "build-resources/icon.png",
      "package.json"
    ],
    "directories": {
      "buildResources": "build-resources",
      "output": "release"
    },
    "asar": true,
    "afterPack": "scripts/after-pack.js",
    "win": {
      "target": "nsis",
      "icon": "build-resources/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "build-resources/icon.png",
      "category": "public.app-category.productivity"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "asarUnpack": [
      "node_modules/sharp/**/*",
      "node_modules/@img/**/*"
    ]
  }
}
